{
  "name": "@erebus/worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "start": "tsx src/scheduler.ts",
    "ingest": "tsx -e \"import('@erebus/ingest').then(m=>m.ingestAll()).then(console.log)\"",
    "garden": "tsx -e \"import('@erebus/gardener').then(m=>m.runGardener()).then(console.log)\"",
    "typecheck": "tsc --noEmit",
    "build": "echo 'worker: source-only'",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@erebus/agents": "workspace:*",
    "@erebus/content": "workspace:*",
    "@erebus/core": "workspace:*",
    "@erebus/db": "workspace:*",
    "@erebus/evals": "workspace:*",
    "@erebus/gardener": "workspace:*",
    "@erebus/ingest": "workspace:*",
    "@erebus/loom": "workspace:*",
    "@erebus/market": "workspace:*",
    "@erebus/shadowboard": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
