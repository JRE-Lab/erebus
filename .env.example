# ============================================================
# EREBUS v2 — Environment
# Copy to .env and fill in. NEVER commit .env.
# ============================================================

# --- Auth (dashboard password) ---
# Leave EREBUS_PASS blank for no auth (local dev). Set it in production.
EREBUS_USER=erebus
EREBUS_PASS=

# --- Database ---
DATABASE_URL=postgresql://erebus:erebus@localhost:5432/erebus
REDIS_URL=redis://localhost:6379

# --- LLM (Anthropic Claude) ---
# Required for live reasoning. App runs in offline/fallback mode if unset.
ANTHROPIC_API_KEY=
# Most capable model for deep reasoning (theory expansion, shadow board):
ANTHROPIC_MODEL_DEEP=claude-opus-4-8
# Faster model for high-volume tasks (classification, annotation):
ANTHROPIC_MODEL_FAST=claude-sonnet-4-6

# --- Embeddings (provider-swappable) ---
# Options: voyage | openai | offline   (offline = deterministic local fallback)
EMBEDDING_PROVIDER=offline
EMBEDDING_DIM=1024
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Ports ---
API_PORT=8787
WEB_PORT=3000

# --- Web -> API wiring (baked into Next.js at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787/ws

# --- Autonomous workers ---
WORKERS_ENABLED=true
INGEST_POLL_MINUTES=30
AUTONOMOUS_EXPLORE_MINUTES=60
EVIDENCE_SWEEP_MINUTES=120
DAILY_LLM_BUDGET_USD=10
