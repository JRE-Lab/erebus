# ============================================================
# EREBUS v2 — environment. Copy to .env. Never commit .env.
# ============================================================

# --- Reasoning (multi-provider with auto-fallback) ---
# LLM_PROVIDER: auto (Claude, fall back to OpenAI on credit/quota error) | anthropic | openai
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPUS_MODEL=claude-opus-4-8
SONNET_MODEL=claude-sonnet-4-6
# OpenAI reasoning fallback (also used for embeddings below)
OPENAI_DEEP_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# --- Data ---
DATABASE_URL=postgresql://erebus:erebus@localhost:5432/erebus
REDIS_URL=redis://localhost:6379

# --- Embeddings (provider-swappable; offline fallback needs no key) ---
# Options: offline | openai | voyage
EMBEDDING_PROVIDER=offline
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Governors (circuit breakers, not leashes) ---
CYCLE_BUDGET_USD=2.00
MAX_DEPTH=8
DAILY_BUDGET_USD=15

# --- Ingestion: comma-separated RSS feeds (the ingest package) ---
NEWS_SOURCES=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://www.theguardian.com/world/rss,https://www.defenseone.com/rss/
# GDELT (free, no key) — broad world-news pull. Disable with GDELT_ENABLED=false.
GDELT_ENABLED=true
GDELT_MAX=75
# GDELT_QUERY=(oil OR sanctions OR ...)   # optional override
REMATCH_EVERY_MIN=45

# --- Worker cadence (minutes) ---
INGEST_EVERY_MIN=30
CYCLE_EVERY_MIN=60
GARDEN_EVERY_MIN=720
WORLDVIEW_EVERY_MIN=1440

# --- Dashboard auth ---
# Blank EREBUS_PASS now FAILS CLOSED (503) — the dashboard will not serve.
# For local dev without auth, set EREBUS_ALLOW_NO_AUTH=1 explicitly.
EREBUS_USER=erebus
EREBUS_PASS=
# EREBUS_ALLOW_NO_AUTH=1

# --- Profit engine (Phase 11) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Web ---
WEB_PORT=3000

# --- Budget governor (shared, enforced inside every LLM call) ---
# DAILY_BUDGET_USD defaults to CYCLE_BUDGET_USD * 10 when unset.
# DAILY_BUDGET_USD=15

# --- LOOM (narrative intelligence layer, Phase 0) ---
LOOM_INGEST_EVERY_MIN=15
# LOOM_WIRE_FEEDS=https://...,https://...      # override wire-release feeds
# LOOM_ARTICLE_FEEDS=https://...,https://...   # override outlet article feeds
# GDELT GKG via BigQuery (optional; requires a GCP project + service account)
# GDELT_BQ_ENABLED=1
# GDELT_BQ_PROJECT=my-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/opt/erebus/gcp-sa.json
