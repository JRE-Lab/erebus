# ============================================================
# EREBUS v2 — environment. Copy to .env. Never commit .env.
# ============================================================

# --- Reasoning (multi-provider with auto-fallback) ---
# LLM_PROVIDER: auto (Claude, fall back to OpenAI on credit/quota error) | anthropic | openai
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPUS_MODEL=claude-opus-4-8
SONNET_MODEL=claude-sonnet-4-6
# OpenAI reasoning fallback (also used for embeddings below)
OPENAI_DEEP_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# --- Data ---
DATABASE_URL=postgresql://erebus:erebus@localhost:5432/erebus
REDIS_URL=redis://localhost:6379

# --- Embeddings (provider-swappable; offline fallback needs no key) ---
# Options: offline | openai | voyage
EMBEDDING_PROVIDER=offline
EMBEDDING_DIM=1536
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5

# --- Governors (circuit breakers, not leashes) ---
CYCLE_BUDGET_USD=2.00
MAX_DEPTH=8
DAILY_BUDGET_USD=15

# --- Ingestion: comma-separated RSS feeds (the ingest package) ---
NEWS_SOURCES=https://feeds.bbci.co.uk/news/world/rss.xml,https://www.aljazeera.com/xml/rss/all.xml,https://www.theguardian.com/world/rss,https://www.defenseone.com/rss/
# GDELT (free, no key) — broad world-news pull. Disable with GDELT_ENABLED=false.
GDELT_ENABLED=true
GDELT_MAX=75
# GDELT_QUERY=(oil OR sanctions OR ...)   # optional override
REMATCH_EVERY_MIN=45

# --- Worker cadence (minutes) ---
INGEST_EVERY_MIN=30
CYCLE_EVERY_MIN=60
GARDEN_EVERY_MIN=720
WORLDVIEW_EVERY_MIN=1440

# --- Dashboard auth ---
# Blank EREBUS_PASS now FAILS CLOSED (503) — the dashboard will not serve.
# For local dev without auth, set EREBUS_ALLOW_NO_AUTH=1 explicitly.
EREBUS_USER=erebus
EREBUS_PASS=
# EREBUS_ALLOW_NO_AUTH=1

# --- Profit engine (Phase 11) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Web ---
WEB_PORT=3000

# --- Budget governor (shared, enforced inside every LLM call) ---
# DAILY_BUDGET_USD defaults to CYCLE_BUDGET_USD * 10 when unset.
# DAILY_BUDGET_USD=15

# --- LOOM (narrative intelligence layer) ---
LOOM_INGEST_EVERY_MIN=15
# Phase 1 — clustering + lifecycle (all defaults from LOOM_SPEC M2)
LOOM_CLUSTER_EVERY_MIN=60
# LOOM_SIM_THRESHOLD=0.70          # cosine sim to join a narrative (tuned for text-embedding-3-small; spec's 0.82 is unreachable on this model)
# LOOM_CLUSTER_WINDOW_DAYS=14      # trailing assignment window
# LOOM_PROMOTE_MIN_ARTICLES=5      # candidate -> narrative bar
# LOOM_PROMOTE_MIN_OUTLETS=3       # (with only 3 feeds configured this means ALL of them; add feeds to loosen)
# LOOM_AMP_MIN=6                   # articles/24h to count as amplifying
# LOOM_PEAK_FRAC=0.8               # crest band vs high-water velocity
# LOOM_DECAY_FRAC=0.5              # decay band
# LOOM_DORMANT_HOURS=48            # silence -> dormant
# Phases 2-4 — entities/market/intent (all free except LLM steps, which are budget-gated)
LOOM_MARKET_EVERY_MIN=360
# LOOM_NER_BATCH=5                 # narratives NER'd per hourly pass
# LOOM_FRAMING_BATCH=20            # articles framed per hourly pass (sampling cap)
# LOOM_ACH_BATCH=3                 # narratives ACH-scored per hourly pass
# LOOM_PRICE_BATCH=60              # instruments refreshed per market pass
# LOOM_THRESH_VOLZ=2.0             # detector thresholds (M5)
# LOOM_THRESH_RESID=0.05
# LOOM_DETECTOR_DAYS=250           # trading days scored per instrument (feeds the placebo pool)
# LOOM_REGIME_DAYS=310             # regime coverage (must span the detector window)
# LOOM_PLACEBO_SAMPLES=1000        # R4 placebo draws per regime
# LOOM_INSIDER_BATCH=15            # companies polled at EDGAR per pass
# LOOM_ACH_MAX_ATTEMPTS=4          # paid ACH failures before a narrative is parked
# LOOM_ACH_COOLDOWN_MIN=360        # min gap between re-scores of one narrative
# LOOM_FRAME_MIN_ROWS=4            # framed articles before frame_homog counts
# LOOM_SIM_VERBATIM=0.95           # text_sim top anchor (near-verbatim wire copy)
# LOOM_PLAYBOOKS_PER_THEORY=3      # cap on LIVE playbooks per theory (retired ones don't count)
# --- Phase 5: analogs (M7), source graph (M4), negative space (M10) ---
# LOOM_ANALOG_K=7                  # precedents kept per narrative
# LOOM_ANALOG_MIN_SIM=0.55         # floor: below this it isn't a precedent
# LOOM_ANALOG_MAX_SIM=0.85         # ceiling: above this it's the SAME story
# LOOM_ANALOG_MIN=5                # precedents required before a prior is used at all
# LOOM_ANALOG_MIN_AGE_H=96         # a precedent must have played out
# LOOM_LEAD_MIN_GAP_MIN=10         # first-mover needs a lead bigger than our poll resolution
# LOOM_SOURCE_WINDOW_DAYS=60       # rolling window for outlet priors
# LOOM_PRIOR_MIN_N=3               # narratives before an outlet's rates are reportable
# LOOM_ASYMMETRY_MIN_N=12          # articles before a coverage-skew z is meaningful
# LOOM_PLAYBOOK_MIN_TERM_LEN=4     # short tokens match everything — reject them
# LOOM_PLAYBOOK_MIN_TERMS=3
# LOOM_PLAYBOOK_MIN_HITS=2
# LOOM_PLAYBOOK_DECAY=0.02         # confidence lost per unmatched day
# LOOM_PLAYBOOK_MAX_DECAY_DAYS=7   # bound so one long gap can't wipe the library
# LOOM_PLAYBOOK_RETIRE=0.15        # below this a playbook stops matching
# LOOM_MAGNITUDE_BAND=1-3%         # market claim size (issuance, prior, and resolution share it)
# --- Bridge: promoted narratives -> theory tree (one `signals` row per narrative) ---
# LOOM_BRIDGE_BATCH=6              # promotions bridged per hourly pass
# LOOM_BRIDGE_MAX_AGE_H=72         # promotions older than this are never bridged (no cold-start backlog)
# LOOM_BRIDGE_WEIGHT_SCALE=0.5     # judge weight multiplier: member articles usually greened the node already
# LOOM_PLAYBOOK_EMBED_MATCH=0.5    # cosine(pattern embedding, narrative centroid) to count as a playbook match
# LOOM_LIFECYCLE_PRIOR=0.45        # hand-set forecast priors (until analogs land)
# LOOM_MARKET_PRIOR=0.55
# LOOM_WIRE_FEEDS=https://...,https://...      # override wire-release feeds
# LOOM_ARTICLE_FEEDS=https://...,https://...   # override outlet article feeds
# GDELT GKG via BigQuery (optional; requires a GCP project + service account)
# GDELT_BQ_ENABLED=1
# GDELT_BQ_PROJECT=my-gcp-project
# GOOGLE_APPLICATION_CREDENTIALS=/opt/erebus/gcp-sa.json
